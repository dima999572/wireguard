services:
  tailscale:
    image: tailscale/tailscale:{{ ts_version }}
    container_name: tailscale
    cap_add:
      - NET_ADMIN
      - NET_RAW
    environment:
      - TS_AUTHKEY={{ ts_auth_key }}
      - TS_STATE_DIR=/var/lib/tailscale
      - TS_USERSPACE=false
      - TS_EXTRA_ARGS={{ tailscale_extra_args | default('') }}
    volumes:
      - {{ ts_stack_dir }}/state:/var/lib/tailscale
      - /dev/net/tun:/dev/net/tun
    restart: always
    network_mode: "host"

{% if enable_nginx | default(false) %}
  nginx:
    image: nginx:alpine
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf
      - /etc/letsencrypt:/etc/letsencrypt # Shared volume for certs
    ports:
      - "443:443"
    depends_on:
      - certbot

  certbot:
    image: certbot/dns-route53
    volumes:
      - /etc/letsencrypt:/etc/letsencrypt
    environment:
      - AWS_ACCESS_KEY_ID={{ aws_access_key }}
      - AWS_SECRET_ACCESS_KEY={{ aws_secret_key }}
    command: >
      certonly --dns-route53 -d {{ domain_name }} 
      --email {{ admin_email }} 
      --agree-tos --no-eff-email 
      --non-interactive

{% endif %}
