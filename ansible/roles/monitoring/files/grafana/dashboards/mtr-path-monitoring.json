    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "The latest mtr run, one row per hop in path order. RTT is cumulative to that hop, so the interesting number is the step between consecutive rows: that is the latency the link into that hop adds. Loss on a middle hop with clean rows below it is ICMP rate-limiting, not lost traffic.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "filterable": false,
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "text", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Hop" },
            "properties": [
              { "id": "custom.width", "value": 70 },
              { "id": "decimals", "value": 0 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Address" },
            "properties": [
              { "id": "custom.width", "value": 300 },
              {
                "id": "links",
                "value": [
                  {
                    "targetBlank": true,
                    "title": "Who owns this hop (WHOIS / ASN)",
                    "url": "https://bgp.he.net/ip/${__value.raw}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Loss %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 1 },
              { "id": "custom.width", "value": 110 },
              {
                "id": "custom.cellOptions",
                "value": { "mode": "gradient", "type": "color-background" }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 1 },
                    { "color": "red", "value": 5 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Sent" },
            "properties": [
              { "id": "decimals", "value": 0 },
              { "id": "custom.width", "value": 80 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Avg" },
            "properties": [
              { "id": "unit", "value": "ms" },
              { "id": "decimals", "value": 1 },
              { "id": "min", "value": 0 },
              {
                "id": "custom.cellOptions",
                "value": { "mode": "gradient", "type": "gauge" }
              }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "Last|Best|Worst|StDev" },
            "properties": [
              { "id": "unit", "value": "ms" },
              { "id": "decimals", "value": 1 },
              { "id": "custom.width", "value": 100 }
            ]
          }
        ]
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 5 },
      "id": 10,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": ["sum"],
          "show": false
        },
        "showHeader": true,
        "sortBy": []
      },
      "pluginVersion": "12.4.6",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "exemplar": false,
          "expr": "max by (count, host) (mtr_report_loss{dst=~\"$dst\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "exemplar": false,
          "expr": "max by (count, host) (mtr_report_snt{dst=~\"$dst\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "exemplar": false,
          "expr": "max by (count, host) (mtr_report_last{dst=~\"$dst\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "exemplar": false,
          "expr": "max by (count, host) (mtr_report_avg{dst=~\"$dst\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "D"
        },
        {
