          "editorMode": "code",
          "exemplar": false,
          "expr": "max by (count, host) (mtr_report_best{dst=~\"$dst\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "E"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
