# Copy to .env and adjust. Paths are host paths handed to Docker, so on Windows
# use the C:/Users/<you>/... form, not the /c/Users/<you>/... form Git Bash shows.

SSH_KEY=C:/Users/<you>/.ssh/raspberry
AWS_DIR=C:/Users/<you>/.aws
SOPS_DIR=C:/Users/<you>/AppData/Roaming/sops

PI_HOST=192.168.1.50
PI_USER=raspberry
# One-time on a new Pi: make ansible-setup-pi-sudo
# (prompts for sudo password once, then become is key-only / NOPASSWD)
